{
  "version": 2,
  "builds": [{ "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }],
  "routes": [
    { "src": "/api/(.*)", "dest": "https://certverify-backend-z4ds.onrender.com/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}